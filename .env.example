# Copy this file to .env.local and set the values from Supabase > Project Settings > API.
# Use the Project URL and publishable key (or the legacy anon key).
# Never use the service_role or secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
